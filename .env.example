# Database (PostgreSQL)
DATABASE_URL="postgresql://firechat:firechat@localhost:5432/firechat?schema=public"

# Auth. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# Server port
PORT=3000

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Redis fan-out (optional). Enables multi-node delivery; omit for single node
REDIS_URL=

# S3-compatible media storage (optional). MinIO/AWS S3/R2; omit for local disk
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
